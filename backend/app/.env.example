# =============================================================================
# SMARTINTERVIEW AI - VARIÁVEIS DE AMBIENTE (BACKEND / FASTAPI)
# =============================================================================
# Copie este arquivo para .env dentro da pasta backend/:
# cp app/.env.example .env

# Chave de API do Google Gemini
GEMINI_API_KEY=sua-chave-gemini-aqui
GEMINI_MODEL=gemini-2.5-flash

# Chave secreta para assinar os tokens JWT de autenticação
JWT_SECRET=sua-chave-secreta-forte-mude-em-producao

# (Opcional) Google Client ID para validação server-side de tokens do Google
GOOGLE_CLIENT_ID=seu-google-client-id-aqui.apps.googleusercontent.com
