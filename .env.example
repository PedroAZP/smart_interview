# =============================================================================
# SMARTINTERVIEW AI - VARIÁVEIS DE AMBIENTE (FRONTEND / NEXT.JS)
# =============================================================================
# Copie este arquivo para .env.local na raiz do projeto:
# cp .env.example .env.local

# URL base da API FastAPI do backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Client ID do Google Cloud Console para o Login com Google
# Obtenha em: https://console.cloud.google.com/apis/credentials
# Crie um "ID do cliente OAuth 2.0" do tipo "Aplicativo da Web"
# e adicione "http://localhost:3000" às Origens JavaScript autorizadas.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=seu-google-client-id-aqui.apps.googleusercontent.com

